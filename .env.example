# 复制成 .env 后按需修改。.env 不会入库（.gitignore 已忽略 .env*）。
# 改完重新构建：uv run build.py
#
# 下面这些值会被写进构建产物，开站后直接生效，不需要再在页面的「API 设置」里填。
# API Key 不在这里：密钥只存在使用者自己的浏览器里，不进构建产物。

# ---------- 站点 ----------

# 站点地址，用于 sitemap 和分享链接。部署到自己的域名时改这里。
POSEWEAR_SITE=https://posewear.pages.dev

# ---------- 预置的模型（部署方决定调谁、用哪个模型） ----------

# 预置的服务商：openai / gemini / seedream / custom
# 留空表示不预置，页面按默认的 OpenAI 走。
POSEWEAR_PROV=custom

# Base URL。自定义中转填中转商给的地址，通常以 /v1 结尾，例如 https://api.example.com/v1
# 留空表示不预置。
POSEWEAR_BASE_URL=https://api.example.com/v1

# 模型名。填中转商实际提供的模型 id，例如 gpt-image-1、gemini-2.5-flash-image、flux-kontext-pro
# 留空表示不预置，用服务商自己的默认模型。
POSEWEAR_MODEL=gpt-image-1

# 接口协议：edits = images/edits（multipart，OpenAI 官方格式）；json = images/generations（JSON 多图，多数中转）
# 留空表示不预置。
POSEWEAR_PROTO=edits

# 参考图的字段名：image[]（官方，多图）或 image（部分中转）
# 留空表示不预置。
POSEWEAR_FIELD=image[]

# ---------- 素材（可选） ----------

# 原始素材目录，默认 assets-raw
# POSEWEAR_RAW=assets-raw
